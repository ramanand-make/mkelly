Options -MultiViews
RewriteEngine On
RewriteBase /

# Redirect collections.php?category=gemini to /collection/gemini
RewriteCond %{THE_REQUEST} /collections\.php\?category=([^&\s]+) [NC]
RewriteRule ^ collection/%1? [R=301,L]

# Internal rewrite for /collection/gemini to collections.php?category=gemini
RewriteRule ^collection/([^/]+)/?$ collections.php?category=$1 [L,QSA]

# Redirect product.php?slug=product-name to /product/product-name
RewriteCond %{THE_REQUEST} /product\.php\?slug=([^&\s]+) [NC]
RewriteRule ^ product/%1? [R=301,L]

# Internal rewrite for /product/product-name to product.php?slug=product-name
RewriteRule ^product/([^/]+)/?$ product.php?slug=$1 [L,QSA]